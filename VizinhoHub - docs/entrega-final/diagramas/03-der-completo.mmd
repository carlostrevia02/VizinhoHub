    users {
        uuid id PK
        text email UK
        text firebase_uid UK
        user_role role
        text store_name
        text neighborhood
        numeric latitude
        numeric longitude
    }
    addresses {
        uuid id PK
        uuid user_id FK
        text label
        text street
        boolean is_primary
    }
    categories {
        int id PK
        text name UK
    }
    products {
        uuid id PK
        uuid user_id FK
        int category_id FK
        text name
        numeric price
        date expiration_date
        boolean is_clearance
        text kind
    }
    orders {
        uuid id PK
        uuid customer_id FK
        uuid merchant_id FK
        order_status status
        order_channel channel
        numeric total_price
        text fulfillment
    }
    order_items {
        uuid id PK
        uuid order_id FK
        uuid product_id FK
        uuid flash_offer_id FK
        int quantity
        numeric unit_price
    }
    flash_offers {
        uuid id PK
        uuid merchant_id FK
        uuid product_id FK
        numeric offer_price
        int qty_total
        int qty_available
        int max_per_customer
        text status
    }
    flash_offer_claims {
        uuid offer_id PK, FK
        uuid customer_id PK, FK
        int qty
    }
    deliveries {
        uuid id PK
        uuid order_id FK
        uuid courier_id FK
        text status
        char pin_code
        int pin_attempts
    }
    couriers {
        uuid user_id PK, FK
        text vehicle
        text status
        boolean approved
    }
    retail_chains {
        int id PK
        text slug UK
        text name UK
        text kind
    }
    chain_branches {
        int id PK
        int chain_id FK
        text name
        numeric latitude
        numeric longitude
    }
    deal_sources {
        int id PK
        int chain_id FK
        text url UK
        text kind
    }
    deals {
        uuid id PK
        int chain_id FK
        int source_id FK
        text product_name
        numeric discount_price
        int discount_pct
        boolean coupon_eligible
    }
    deal_coupons {
        uuid id PK
        text code UK
        uuid deal_id FK
        uuid customer_id FK
        coupon_status status
        timestamptz expires_at
    }
    retail_chain_managers {
        int chain_id PK, FK
        uuid user_id PK, FK
    }

%%{init: {'theme':'base','themeVariables':{'primaryColor':'#E8F5E9','primaryBorderColor':'#2E7D32','primaryTextColor':'#1B2A1F','lineColor':'#455A64','fontFamily':'Arial','fontSize':'14px'}}}%%
erDiagram
    users ||--o| store_delivery_config : configura
    deliveries ||--o{ delivery_offers : convida
    couriers ||--o{ delivery_offers : recebe
    deliveries ||--o{ courier_location_log : rastreia

    users ||--o{ credit_accounts : "loja e cliente"
    credit_accounts ||--o{ credit_ledger : lanca
    orders |o--o{ credit_ledger : "pago a fiado"

    users ||--o{ pickup_slots : "faixas da loja"
    pickup_slots ||--o{ slot_bookings : "vagas por dia"
    pickup_slots |o--o{ orders : "encomenda"

    products ||--o{ combo_items : "combo"
    products ||--o{ combo_items : "componente"
    products ||--o{ daily_menu : "prato do dia"

    vip_plans ||--o{ vip_tiers : "faixas de desconto"
    vip_plans ||--o{ vip_subscriptions : contrata
    users ||--o{ vip_subscriptions : assina
    vip_subscriptions ||--o{ vip_invoices : cobra
    users ||--o| vip_merchants : "loja aderente"

    canonical_products ||--o{ products : "classifica"
    canonical_products ||--o{ recipe_ingredients : "ingrediente"
    recipes ||--o{ recipe_ingredients : leva
    users ||--o{ shopping_lists : salva
    shopping_lists ||--o{ shopping_list_items : itens
    canonical_products |o--o{ shopping_list_items : "item"

    users ||--o{ store_events : "funil (90 dias)"
    products |o--o{ store_events : "visualizado"

    store_delivery_config {
        uuid merchant_id PK, FK
        boolean has_own_fleet
        int delivery_radius_m
        boolean flash_enabled
    }
    deliveries {
        uuid id PK
        uuid order_id FK
        uuid courier_id FK
        text status
    }
    couriers {
        uuid user_id PK, FK
        text vehicle
        text status
    }
    delivery_offers {
        uuid delivery_id PK, FK
        uuid courier_id PK, FK
        text status
        timestamptz expires_at
    }
    courier_location_log {
        bigint id PK
        uuid delivery_id FK
        numeric lat
        numeric lng
    }
    credit_accounts {
        uuid id PK
        uuid merchant_id FK
        uuid customer_id FK
        numeric credit_limit
        numeric balance
    }
    credit_ledger {
        bigint id PK
        uuid account_id FK
        uuid order_id FK
        text kind
        numeric amount
    }
    orders {
        uuid id PK
        uuid slot_id FK
        timestamptz scheduled_for
    }
    pickup_slots {
        uuid id PK
        uuid merchant_id FK
        smallint weekday
        int capacity
    }
    slot_bookings {
        uuid slot_id PK, FK
        date slot_date PK
        int booked
    }
    products {
        uuid id PK
        int canonical_id FK
        text kind
    }
    combo_items {
        uuid combo_id PK, FK
        uuid component_id PK, FK
        int quantity
    }
    daily_menu {
        uuid id PK
        uuid product_id FK
        date menu_date
        boolean is_on
        int qty_available
    }
    vip_plans {
        int id PK
        text code UK
        numeric price_monthly
    }
    vip_tiers {
        int plan_id PK, FK
        smallint min_months PK
        numeric discount_pct
    }
    vip_subscriptions {
        uuid id PK
        uuid user_id FK
        int plan_id FK
        text status
    }
    vip_invoices {
        uuid id PK
        uuid subscription_id FK
        numeric amount
        text status
    }
    vip_merchants {
        uuid merchant_id PK, FK
        numeric discount_cap_pct
    }
    canonical_products {
        int id PK
        text name UK
        text barcode UK
    }
    recipes {
        uuid id PK
        text slug UK
        text title
    }
    recipe_ingredients {
        uuid recipe_id PK, FK
        int canonical_id PK, FK
        numeric quantity
    }
    shopping_lists {
        uuid id PK
        uuid user_id FK
        text title
    }
    shopping_list_items {
        uuid id PK
        uuid list_id FK
        int canonical_id FK
        numeric quantity
    }
    store_events {
        bigint id PK
        uuid merchant_id FK
        uuid session_id
        text type
        uuid product_id FK
    }

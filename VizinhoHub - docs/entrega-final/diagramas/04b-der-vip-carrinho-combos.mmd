    products {
        uuid id PK
        int canonical_id FK
        text kind
    }
    combo_items {
        uuid combo_id PK, FK
        uuid component_id PK, FK
        int quantity
    }
    daily_menu {
        uuid id PK
        uuid product_id FK
        date menu_date
        boolean is_on
        int qty_available
    }
    vip_plans {
        int id PK
        text code UK
        numeric price_monthly
    }
    vip_tiers {
        int plan_id PK, FK
        smallint min_months PK
        numeric discount_pct
    }
    vip_subscriptions {
        uuid id PK
        uuid user_id FK
        int plan_id FK
        text status
    }
    vip_invoices {
        uuid id PK
        uuid subscription_id FK
        numeric amount
        text status
    }
    vip_merchants {
        uuid merchant_id PK, FK
        numeric discount_cap_pct
    }
    canonical_products {
        int id PK
        text name UK
        text barcode UK
    }
    recipes {
        uuid id PK
        text slug UK
        text title
    }
    recipe_ingredients {
        uuid recipe_id PK, FK
        int canonical_id PK, FK
        numeric quantity
    }
    shopping_lists {
        uuid id PK
        uuid user_id FK
        text title
    }
    shopping_list_items {
        uuid id PK
        uuid list_id FK
        int canonical_id FK
        numeric quantity
    }

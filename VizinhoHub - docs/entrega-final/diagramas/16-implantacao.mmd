%%{init: {'theme':'base','themeVariables':{'primaryColor':'#E8F5E9','primaryBorderColor':'#2E7D32','primaryTextColor':'#1B2A1F','lineColor':'#455A64','fontFamily':'Arial','fontSize':'15px'},'flowchart':{'nodeSpacing':30,'rankSpacing':60,'wrappingWidth':300}}}%%
flowchart LR
    subgraph USR["Dispositivos"]
        direction TB
        NAV["Navegador ou PWA instalado<br/>cliente, comerciante, entregador"]:::dev
    end

    subgraph NUV["Opção A · nuvem (render.yaml)"]
        direction TB
        FRONT["<b>Vercel ou Cloudflare Pages</b><br/>apps/web/dist (estático)<br/>vercel.json e _headers"]:::no
        subgraph RND["Render"]
            direction TB
            API1["<b>Web Service vizinhohub-api</b><br/>Node 24, tsx, HTTP e WebSocket<br/>healthCheck /health<br/>preDeploy: npm run db:setup"]:::no
            PG1[("<b>Render Postgres</b><br/>vizinhohub-db")]:::banco
        end
        API1 -->|"DATABASE_URL"| PG1
    end

    subgraph VPS["Opção B · VPS (sem container)"]
        direction TB
        NGX["<b>nginx ou Caddy</b><br/>HTTPS, estáticos de apps/web/dist<br/>proxy de /api e /socket.io"]:::no
        PM2["<b>PM2: vizinhohub-api</b><br/>ecosystem.config.cjs<br/>autorestart e .env.prod"]:::no
        PG2[("<b>PostgreSQL 16</b><br/>local na VPS")]:::banco
        NGX -->|"127.0.0.1:3333"| PM2
        PM2 --> PG2
    end

    subgraph EXT["Serviços externos"]
        direction TB
        FB["Firebase Auth"]:::ext
        CL["Claude API"]:::ext
        OSM["OSRM e Overpass (OpenStreetMap)"]:::ext
        AS["Asaas"]:::ext
    end

    NAV -->|"HTTPS: página, cache do PWA"| FRONT
    NAV -->|"HTTPS e WSS (CORS_ORIGIN)"| API1
    NAV -->|"HTTPS e WSS (mesma origem)"| NGX
    API1 -.-> EXT
    PM2 -.-> EXT

    classDef dev fill:#FFF8E1,stroke:#F9A825,stroke-width:2px,color:#3E2F00
    classDef no fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B2A1F
    classDef banco fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D2A4A
    classDef ext fill:#ECEFF1,stroke:#607D8B,stroke-width:2px,color:#263238
    style USR fill:#FFFFFF,stroke:#B0BEC5
    style NUV fill:#F7FCF7,stroke:#2E7D32,stroke-width:2px
    style RND fill:#F1F8E9,stroke:#9CCC65
    style VPS fill:#FFFDF5,stroke:#F9A825,stroke-width:2px
    style EXT fill:#FFFFFF,stroke:#B0BEC5,stroke-dasharray: 5 5

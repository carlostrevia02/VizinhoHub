%%{init: {'theme':'base','themeVariables':{'primaryColor':'#E8F5E9','primaryBorderColor':'#2E7D32','primaryTextColor':'#1B2A1F','lineColor':'#455A64','fontFamily':'Arial','fontSize':'15px'},'flowchart':{'nodeSpacing':40,'rankSpacing':70,'wrappingWidth':420}}}%%
flowchart TB
    subgraph PESSOAS["Pessoas"]
        direction LR
        CLI(["<b>Cliente</b><br/>[Pessoa]<br/>Morador que busca<br/>ofertas e faz pedidos"]):::pessoa
        COM(["<b>Comerciante</b><br/>[Pessoa]<br/>Dono do mercadinho,<br/>atende pedidos"]):::pessoa
        ENT(["<b>Entregador</b><br/>[Pessoa]<br/>Autônomo do bairro"]):::pessoa
        GER(["<b>Gerente de rede</b><br/>[Pessoa]<br/>Envia encartes<br/>da rede"]):::pessoa
    end

    VH["<b>VizinhoHub</b><br/>[Sistema de software]<br/>Vitrine de ofertas dos supermercados do bairro,<br/>pedidos em tempo real, cupons de retirada,<br/>painel do comerciante e logística"]:::sistema

    subgraph EXT["Sistemas externos"]
        direction LR
        FB["<b>Firebase Auth</b><br/>[Sistema externo]<br/>Identidade<br/>(ID token)"]:::externo
        CL["<b>Claude API</b><br/>[Sistema externo]<br/>Extrai ofertas de<br/>páginas e encartes"]:::externo
        OSM["<b>OSRM / OpenStreetMap</b><br/>[Sistema externo]<br/>Rotas e filiais<br/>das redes"]:::externo
        AS["<b>Gateway Asaas</b><br/>[Sistema externo]<br/>Cobrança do<br/>Clube VIP"]:::externo
        WA["<b>WhatsApp</b><br/>[Sistema externo]<br/>Contato e cobrança<br/>(link wa.me)"]:::externo
        RS["<b>Redes de supermercado</b><br/>[Sistema externo]<br/>Sites e encartes<br/>de ofertas"]:::externo
    end

    CLI -->|"consulta ofertas, pede,<br/>acompanha e reserva cupom"| VH
    COM -->|"gerencia catálogo, ofertas<br/>e pedidos (Kanban)"| VH
    ENT -->|"aceita corridas e<br/>confirma entrega (PIN)"| VH
    GER -->|"envia encartes<br/>(PDF ou imagem)"| VH

    VH -->|"valida o ID token"| FB
    VH -->|"envia texto e imagem<br/>recebe ofertas em JSON"| CL
    VH -->|"calcula rota e<br/>busca filiais"| OSM
    VH -->|"cria assinatura<br/>recebe webhook"| AS
    VH -.->|"gera link com<br/>mensagem pronta"| WA
    VH -->|"lê páginas<br/>(respeita robots.txt)"| RS

    classDef pessoa fill:#FFF8E1,stroke:#F9A825,stroke-width:2px,color:#3E2F00
    classDef sistema fill:#2E7D32,stroke:#1B5E20,stroke-width:2px,color:#FFFFFF
    classDef externo fill:#ECEFF1,stroke:#607D8B,stroke-width:2px,color:#263238
    style PESSOAS fill:#FFFFFF,stroke:#FFFFFF
    style EXT fill:#FFFFFF,stroke:#FFFFFF

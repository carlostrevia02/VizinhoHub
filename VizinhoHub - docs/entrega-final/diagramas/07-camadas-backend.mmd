flowchart TB
    CLIENTE(["Web PWA, MCP Server e webhooks<br/>HTTP /api/v1 e WebSocket"]):::ext
    SCHEMA["<b>schema</b>  *.schema.ts<br/>schemas zod e<br/>tipos de entrada"]:::lateral

    ROUTES["<b>1 · routes</b>  *.routes.ts<br/>Express 5: autentica, confere o papel,<br/>valida a entrada e chama o serviço"]:::camada
    SERVICE["<b>2 · service</b>  *.service.ts<br/>regras de negócio e transações:<br/>máquina de estados, ofertas, cupons"]:::camada
    REPO["<b>3 · repository</b>  *.repository.ts<br/>SQL explícito com pg (sem ORM)"]:::camada
    EVENTS["<b>eventos</b><br/>OrderEvents e DeliveryEvents<br/>o serviço não conhece o Socket.io"]:::lateral
    SHARED["<b>shared/</b><br/>auth · db · errors · realtime<br/>jobs · rate-limit · env<br/>firebase · password"]:::shared
    DB[("<b>PostgreSQL 16</b><br/>transações, UPDATE condicional,<br/>funções e views")]:::banco

    subgraph MOD["modules/  ·  cada módulo repete o formato schema, repository, service e routes"]
        direction LR
        M1["<b>Núcleo</b><br/>auth · products · categories<br/>orders · pos · stores · addresses"]:::mod
        M2["<b>Ofertas</b><br/>flash · daily-menu · deals<br/>branches · catalog-live"]:::mod
        M3["<b>Operação e logística</b><br/>delivery · ops · scheduling<br/>credit · smart-cart · vip"]:::mod
        M4["<b>Análise</b><br/>analytics · reports"]:::mod
    end

    CLIENTE -->|"requisição"| ROUTES
    SCHEMA -.->|"valida"| ROUTES
    ROUTES --> SERVICE
    SERVICE --> REPO
    SERVICE -.->|"publica após o COMMIT"| EVENTS
    SERVICE -.->|"usa"| SHARED
    REPO -->|"SQL"| DB
    DB ~~~ MOD


# Banco (docker-compose.yml)
POSTGRES_USER=vizinhohub
POSTGRES_PASSWORD=vizinhohub
POSTGRES_DB=vizinhohub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vizinhohub:vizinhohub@localhost:5432/vizinhohub

# API (apps/api)
API_PORT=3333
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Firebase: projeto cujos ID tokens a API aceita em POST /api/v1/auth/firebase
FIREBASE_PROJECT_ID=vizinhohub

# Ofertas do Bairro (opcional): chave do Claude para o job horário que lê os supermercados.
# ANTHROPIC_API_KEY=
# DEALS_MODEL=claude-opus-5-5

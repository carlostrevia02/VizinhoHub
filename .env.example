# Banco local: `npm run dev:db` (em apps/api) sobe um Postgres embutido nesta URL, sem Docker.
# Produção: veja .env.prod.example.
DATABASE_URL=postgresql://vizinhohub:vizinhohub@localhost:5432/vizinhohub

# API (apps/api)
API_PORT=3333
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Documentação da API: Swagger UI em /api/docs e spec em /api/openapi.json (true | false; padrão true).
API_DOCS=true

# Firebase: projeto cujos ID tokens a API aceita em POST /api/v1/auth/firebase
FIREBASE_PROJECT_ID=vizinhohub

# Ofertas do Bairro (opcional): chave do Claude para o job horário que lê os supermercados.
# ANTHROPIC_API_KEY=
# DEALS_MODEL=claude-opus-5-5
# DEALS_SCAN_INTERVAL_MIN=60
# DEALS_USER_AGENT=VizinhoHubBot/1.0 (ofertas de bairro; contato: voce@exemplo.com)

# Clube VIP (Selo Vizinho VIP): provedor de pagamento da assinatura. A plataforma NÃO custodia valores.
#   mock  = simula a cobrança (padrão em dev/teste/CI). Segredo do webhook no header x-vip-webhook-secret.
#   asaas = Asaas (assinatura recorrente Pix/cartão). Use o Sandbox: https://sandbox.asaas.com
VIP_PROVIDER=mock
# VIP_MOCK_WEBHOOK_SECRET=dev-vip-webhook-secret
# ASAAS_API_KEY=            # chave de API do Asaas (Sandbox)
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=      # 16+ caracteres; o mesmo token cadastrado no webhook do Asaas (vai no header asaas-access-token)

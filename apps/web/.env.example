# Firebase — Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API do VizinhoHub (ofertas do bairro e cupons)
VITE_API_URL=http://localhost:3333/api/v1

# Google Maps (opcional): habilita a busca de endereços do Google no diálogo de endereços.
# Ative "Maps JavaScript API", "Places API (New)" e "Geocoding API". Sem a chave, usa OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=

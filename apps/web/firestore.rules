rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Papel guardado no próprio banco (users/{uid}.role). Só o console/admin promove a MERCHANT.
    function isMerchant() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MERCHANT';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMerchant());
      // Todo mundo nasce CUSTOMER: ninguém se auto-promove a comerciante.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'CUSTOMER'
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt']);
      // Pode editar os próprios dados, mas nunca o papel.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isMerchant());
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      // O comerciante só avança o status; o conteúdo do pedido é imutável.
      allow update: if isMerchant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }
  }
}

# Produção/homologação (sem Docker). NÃO versionado quando copiado para .env.prod.
#  - PaaS (Render etc.): cadastre estas variáveis no painel (o render.yaml já declara as principais).
#  - VPS com PM2: copie para .env.prod na raiz do repo (ecosystem.config.cjs lê esse arquivo).
NODE_ENV=production
API_PORT=3333

# Postgres gerenciado ou local. Rode `npm run db:setup` em apps/api (aplica schema, migrações e fuso; sem seed).
DATABASE_URL=postgresql://usuario:senha@host:5432/vizinhohub

# Obrigatório e validado em produção: 32+ caracteres, aleatório, sem "dev", "secret", "change", "123".
# Gere com: openssl rand -hex 32
JWT_SECRET=
# Origem(ns) do site (front), separadas por vírgula; HTTP e WebSocket. Não pode conter localhost em produção.
CORS_ORIGIN=https://vizinhohub.example.com

# Clube VIP: mock simula a cobrança; asaas usa o provedor real (exige ASAAS_API_KEY e ASAAS_WEBHOOK_TOKEN).
VIP_PROVIDER=mock
# Em produção, sem este segredo (8+ caracteres) o webhook mock recusa tudo.
# VIP_MOCK_WEBHOOK_SECRET=
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://api.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=            # 16+ caracteres

# Login social: projeto Firebase cujos ID tokens a API aceita. Sem isso POST /auth/firebase responde 501.
# FIREBASE_PROJECT_ID=

# Ofertas do Bairro (opcional): sem a chave o job fica desligado.
# ANTHROPIC_API_KEY=
# DEALS_MODEL=claude-opus-5-5
# DEALS_SCAN_INTERVAL_MIN=60
# DEALS_USER_AGENT=VizinhoHubBot/1.0 (ofertas de bairro; contato: voce@exemplo.com)

# Web Push (gere com: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@seudominio.com

# ---- Front (apps/web): variáveis de BUILD (Vercel/Cloudflare Pages), não da API ----
# VITE_API_URL=https://api.seudominio.com/api/v1
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
